# Copy to .env for local development (npm run dev). On Vercel, set these under Settings > Environment Variables.

# Required
ADMIN_PASSWORD=choose-a-long-password      # coach dashboard sign-in

# Database
# On Vercel, connecting a Neon database (Storage tab) sets DATABASE_URL for you.
# Leave it empty on your computer to use the built-in local database in data/pglite.
DATABASE_URL=

# Payments: leave empty for demo mode (bookings work, payments are simulated, no card is charged)
STRIPE_SECRET_KEY=                         # sk_live_... or sk_test_...
STRIPE_WEBHOOK_SECRET=                     # whsec_... from the webhook you add in Stripe
PUBLIC_URL=                                # e.g. https://kb-movement.vercel.app (used in invite messages and Stripe return links)

# Optional
SESSION_SECRET=                            # set to sign coaches out on demand; otherwise derived from ADMIN_PASSWORD

# Business details shown on the site (optional)
BUSINESS_NAME=KB Movement
COACH_NAME=
LOCATION=                                  # e.g. "Riverside Park, Field 3" (shown on confirmations and calendar invites)
CONTACT_EMAIL=
CONTACT_PHONE=
TIME_ZONE=America/New_York

# Prices in dollars, capacity per group session
PRICE_DROP_IN=59.99
PRICE_WEEK_BUNDLE=159.99
PRICE_PRIVATE=99.99
GROUP_CAPACITY=15
WEEKS_AHEAD=8
BOOKING_CUTOFF_MINUTES=60

# Winter Select tournament host
TOURNAMENT_HOST_NAME=Soccer Coliseum
TOURNAMENT_HOST_URL=https://soccercoliseum.com/tournaments/schedule/
